<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon); WinForms namespaces are not imported globally. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU</Platforms>
    <RuntimeIdentifiers>win-x64;win-x86</RuntimeIdentifiers>
    <AssemblyName>DualSenseAudioStudio</AssemblyName>
    <RootNamespace>DualSenseAudioStudio</RootNamespace>
    <Version>1.0.14</Version>
    <AssemblyVersion>1.0.14.0</AssemblyVersion>
    <FileVersion>1.0.14.0</FileVersion>
    <InformationalVersion>1.0.14</InformationalVersion>
    <Product>DualSense Bluetooth Audio</Product>
    <Authors>DualSense Bluetooth Audio contributors</Authors>
    <Description>Stream Windows audio to a DualSense over Bluetooth.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright © 2026 DualSense Bluetooth Audio contributors</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
      <!-- Precompiled (faster start, steadier timing) with profile-guided JIT. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="HidApi.Net" Version="1.2.0" />
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\DualSense.png" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DualSenseStudio.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/AudioPolicy.cs" Link="AudioPolicy.cs" />
  </ItemGroup>
</Project>

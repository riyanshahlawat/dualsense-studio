<Window x:Class="DualSenseAudioStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DualSense Studio"
        Width="1240"
        Height="790"
        MinWidth="760"
        MinHeight="520"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <!-- Normal resizable window (drag any edge) with the custom PS5 title bar. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <LinearGradientBrush x:Key="WindowBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0A2A66" Offset="0" /><GradientStop Color="#05183D" Offset="0.45" /><GradientStop Color="#020814" Offset="1" /></LinearGradientBrush>
        <SolidColorBrush x:Key="SidebarBrush" Color="#66040C1F" />
        <SolidColorBrush x:Key="CardBrush" Color="#1DFFFFFF" />
        <SolidColorBrush x:Key="CardHoverBrush" Color="#22FFFFFF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#28FFFFFF" />
        <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#A7ADB9" />
        <SolidColorBrush x:Key="AccentBrush" Color="#0070D1" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#0D3B73" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#54D6A4" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FF6B7A" />

        <Geometry x:Key="IconHome">M3,11 L12,3 L21,11 L19,11 L19,21 L14,21 L14,15 L10,15 L10,21 L5,21 L5,11 Z</Geometry>
        <Geometry x:Key="IconAudio">M4,9 L8,9 L13,4 L13,20 L8,15 L4,15 Z M16,8 C18,10 18,14 16,16 M18.5,5.5 C22,9 22,15 18.5,18.5</Geometry>
        <Geometry x:Key="IconLight">M12,2 C6.5,2 2,6.3 2,11.5 C2,16.2 5.7,20 10.2,20 L11.4,20 C12.7,20 13.4,18.4 12.5,17.5 C11.8,16.8 12.3,15.6 13.3,15.6 L15.5,15.6 C19.1,15.6 22,12.7 22,9.2 C22,5.2 17.6,2 12,2 Z M7,12.5 A1.4,1.4 0 1 0 7,9.7 A1.4,1.4 0 1 0 7,12.5 M10,8.5 A1.4,1.4 0 1 0 10,5.7 A1.4,1.4 0 1 0 10,8.5 M15,8.5 A1.4,1.4 0 1 0 15,5.7 A1.4,1.4 0 1 0 15,8.5 M18,12.5 A1.4,1.4 0 1 0 18,9.7 A1.4,1.4 0 1 0 18,12.5</Geometry>
        <Geometry x:Key="IconActivity">M3,12 L7,12 L9.5,5 L14,19 L16.5,12 L21,12</Geometry>
        <Geometry x:Key="IconSettings">M12,8.5 A3.5,3.5 0 1 0 12,15.5 A3.5,3.5 0 1 0 12,8.5 M19.4,15 A7.8,7.8 0 0 0 19.5,9 L22,7.5 L20,4 L17.2,5 A8,8 0 0 0 12,2 L11.5,5 A7.5,7.5 0 0 0 7,6.1 L4.6,4.6 L2.5,8 L5,9.7 A7.8,7.8 0 0 0 5.2,15 L2.8,16.6 L5,20 L7.7,18.8 A8,8 0 0 0 12.3,20 L12.8,23 L16.8,22 L16.5,19 A8,8 0 0 0 19.4,15 Z</Geometry>
        <Geometry x:Key="IconPlay">M7,4 L20,12 L7,20 Z</Geometry>
        <Geometry x:Key="IconStop">M6,6 L18,6 L18,18 L6,18 Z</Geometry>
        <Geometry x:Key="IconRefresh">M20,7 L20,2 L18,4 A9,9 0 1 0 20.5,14 L18,14 A6.5,6.5 0 1 1 16.3,6 L14,8 L20,8 Z</Geometry>
        <Geometry x:Key="IconCheck">M4,12 L9,17 L20,6</Geometry>
        <Geometry x:Key="IconFolder">M3,5 L10,5 L12,7 L21,7 L21,19 L3,19 Z</Geometry>
        <Geometry x:Key="IconTrash">M5,7 L19,7 M9,7 L9,4 L15,4 L15,7 M7,7 L8,21 L16,21 L17,7 M10,10 L10,18 M14,10 L14,18</Geometry>
        <Geometry x:Key="IconHeadset">M4,13 L4,11 A8,8 0 0 1 20,11 L20,13 M4,13 L8,13 L8,20 L4,20 Z M16,13 L20,13 L20,20 L16,20 Z</Geometry>
        <Geometry x:Key="IconSpeaker">M4,9 L8,9 L13,4 L13,20 L8,15 L4,15 Z M17,9 A4,4 0 0 1 17,15</Geometry>
        <Geometry x:Key="IconController">M7,9 L17,9 C20,9 22,13 21,17 C20.5,19.5 18.5,20 17,18 L15,15 L9,15 L7,18 C5.5,20 3.5,19.5 3,17 C2,13 4,9 7,9 Z M7,11 L7,15 M5,13 L9,13 M16.5,12 L18.5,12 M17.5,11 L17.5,13</Geometry>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="22" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="22"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#24FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#29FFFFFF" />
            <Setter Property="Foreground" Value="#FF9AA5" />
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="22"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#21FFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#D9E1EC" />
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="7"
                                Margin="4,2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2DFFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#0059B2" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemBorder" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E7ECF4" />
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="MinHeight" Value="39" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboBorder"
                                                Background="#1AFFFFFF"
                                                BorderBrush="#293548"
                                                BorderThickness="1"
                                                CornerRadius="9" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#757B87" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#6CB5FF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Grid IsHitTestVisible="False" Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                                <Path Grid.Column="1"
                                      Data="M3,6 L8,11 L13,6"
                                      Stroke="#AEB4C0"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Stretch="Uniform"
                                      Width="11"
                                      Height="7"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center" />
                            </Grid>

                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=DropDownToggle}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Width="{Binding ActualWidth, ElementName=DropDownToggle}"
                                        Background="#17FFFFFF"
                                        BorderBrush="#344158"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="3"
                                        Margin="0,5,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#0EFFFFFF" BlurRadius="20" ShadowDepth="5" Opacity="0.55" />
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="250"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PS5 slider: thin rounded track, blue filled part, white round knob. -->
        <Style x:Key="Ps5SliderRepeat" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="6" CornerRadius="3" Background="#33FFFFFF" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource Ps5SliderRepeat}" Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" CornerRadius="3" Background="#1F8FFF" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource Ps5SliderRepeat}" Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="20" Height="20" Fill="White">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#7FB8FF" Opacity="0.8" />
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PS5 color swatch: round chip; Background is the color. -->
        <Style x:Key="SwatchStyle" TargetType="Button">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Margin" Value="0,0,14,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="{TemplateBinding Background}" />
                            <Ellipse x:Name="Hover" Stroke="White" StrokeThickness="2" Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PS5 toggles: checkbox as a switch, radio as a ring. -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E4EAF3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Track" Width="40" Height="22" CornerRadius="11" Background="#40FFFFFF" VerticalAlignment="Center">
                                <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="3,0" />
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#1F8FFF" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PS5 home tile: rounded glass square; selected (Tag on Opacity trick via code) grows with a white ring. -->
        <Style x:Key="HomeTileStyle" TargetType="Button">
            <Setter Property="Width" Value="96" />
            <Setter Property="Height" Value="96" />
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="BorderBrush" Value="#00FFFFFF" />
            <Setter Property="RenderTransformOrigin" Value="0.5,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Tile" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="3" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="#3DFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#BAC4D3" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource WindowBrush}"
            BorderBrush="#2DFFFFFF"
            BorderThickness="1"
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="0" Opacity="0.48" Color="#0EFFFFFF" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#00000000" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="138" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Border Width="24" Height="24" CornerRadius="7" Background="{StaticResource AccentBrush}">
                        <Path Data="{StaticResource IconController}" Stroke="White" StrokeThickness="1.7" Stretch="Uniform" Margin="4" />
                    </Border>
                    <TextBlock Text="DUALSENSE STUDIO" Foreground="{StaticResource TextBrush}" FontWeight="Bold" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
                    <Border Background="#0059B2" CornerRadius="7" Padding="7,3" Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v1.0.12" Foreground="#C8D0FF" FontSize="9" FontWeight="Bold" />
                    </Border>
                </StackPanel>

                <!-- Shown when GitHub has a newer version. -->
                <Button x:Name="UpdateButton" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,420,0"
                        Style="{StaticResource SecondaryButtonStyle}" Padding="14,6" Click="UpdateButton_Click">
                    <TextBlock x:Name="UpdateButtonText" Text="Check for updates" FontSize="12" />
                </Button>
                <!-- Power: stop everything (zero background load) or start again. -->
                <Button x:Name="PowerButton" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,262,0"
                        Style="{StaticResource SecondaryButtonStyle}" Padding="14,6" Click="PowerButton_Click" ToolTip="Start or stop audio, mic and game controllers">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="PowerDot" Width="8" Height="8" Fill="#54D6A4" VerticalAlignment="Center" />
                        <TextBlock x:Name="PowerText" Text="Running · Stop" Margin="8,0,0,0" FontSize="12" />
                    </StackPanel>
                </Button>
                <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Background="#1DFFFFFF" CornerRadius="12" Padding="10,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ClockText" Text="00:00" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="0,0,14,0" VerticalAlignment="Center" />
                        <Ellipse x:Name="TopStatusDot" Width="7" Height="7" Fill="#828894" VerticalAlignment="Center" />
                        <TextBlock x:Name="TopStatusText" Text="Engine stopped" Foreground="#B6C1D0" FontSize="11" Margin="7,0,0,0" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Width="44" Height="48" Background="Transparent" BorderThickness="0" Click="MinimizeButton_Click" ToolTip="Minimize">
                        <Path Data="M5,12 L19,12" Stroke="#B9BFCB" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" />
                    </Button>
                    <Button Width="44" Height="48" Background="Transparent" BorderThickness="0" Click="MaximizeButton_Click" ToolTip="Maximize">
                        <Rectangle Width="11" Height="11" Stroke="#B9BFCB" StrokeThickness="1.2" />
                    </Button>
                    <Button Width="44" Height="48" Background="Transparent" BorderThickness="0" Click="CloseButton_Click" ToolTip="Close">
                        <Path Data="M5,5 L19,19 M19,5 L5,19" Stroke="#B9BFCB" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- PS5 home-style tile row: big rounded tiles, the selected one grows and shows its name. -->
                <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" Margin="40,18,40,0" Height="150" VerticalAlignment="Top">
                    <Button x:Name="HomeTileDashboard" Style="{StaticResource HomeTileStyle}" Tag="Dashboard" Click="NavigationButton_Click">
                        <Path Data="{StaticResource IconHome}" Fill="White" Width="34" Height="34" Stretch="Uniform" />
                    </Button>
                    <Button x:Name="HomeTileController" Style="{StaticResource HomeTileStyle}" Tag="Controller" Click="NavigationButton_Click">
                        <Path Data="{StaticResource IconController}" Stroke="White" StrokeThickness="1.6" Width="44" Height="44" Stretch="Uniform" />
                    </Button>
                    <Button x:Name="HomeTileAudio" Style="{StaticResource HomeTileStyle}" Tag="Audio" Click="NavigationButton_Click">
                        <Path Data="{StaticResource IconHeadset}" Stroke="White" StrokeThickness="1.6" Width="40" Height="40" Stretch="Uniform" />
                    </Button>
                    <Button x:Name="HomeTileLighting" Style="{StaticResource HomeTileStyle}" Tag="Lighting" Click="NavigationButton_Click">
                        <Path Data="{StaticResource IconLight}" Fill="White" Width="38" Height="38" Stretch="Uniform" />
                    </Button>
                    <Button x:Name="HomeTileDiagnostics" Style="{StaticResource HomeTileStyle}" Tag="Diagnostics" Click="NavigationButton_Click">
                        <Path Data="{StaticResource IconActivity}" Stroke="White" StrokeThickness="2" Width="38" Height="38" Stretch="Uniform" />
                    </Button>
                    <Button x:Name="HomeTileSettings" Style="{StaticResource HomeTileStyle}" Tag="Settings" Click="NavigationButton_Click">
                        <Path Data="{StaticResource IconSettings}" Fill="White" Width="36" Height="36" Stretch="Uniform" />
                    </Button>
                    <TextBlock x:Name="HomeTileLabel" Text="Home" Foreground="White" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" Margin="18,0,0,22" />
                </StackPanel>

                <Border Grid.RowSpan="2" Visibility="Collapsed" Background="{StaticResource SidebarBrush}" BorderBrush="#24FFFFFF" BorderThickness="0,1,1,0" CornerRadius="0,0,0,16">
                    <Grid Margin="16,22,16,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="NAVIGATION" Foreground="#7E8490" FontSize="10" FontWeight="Bold" Margin="12,0,0,10" />

                            <Button x:Name="DashboardNavButton" Style="{StaticResource NavButtonStyle}" Tag="Dashboard" Click="NavigationButton_Click" Background="#FFFFFFFF" Foreground="White">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconHome}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="18" Height="18" Stretch="Uniform" />
                                    <TextBlock Text="Overview" Margin="13,0,0,0" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="AudioNavButton" Style="{StaticResource NavButtonStyle}" Tag="Audio" Click="NavigationButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconAudio}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform" />
                                    <TextBlock Text="Audio" Margin="13,0,0,0" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="LightingNavButton" Style="{StaticResource NavButtonStyle}" Tag="Lighting" Click="NavigationButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconLight}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="18" Height="18" Stretch="Uniform" />
                                    <TextBlock Text="Lighting" Margin="13,0,0,0" FontWeight="SemiBold" />
                                    <Border Background="#27FFFFFF" BorderBrush="#6A5126" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="8,0,0,0">
                                        <TextBlock Text="BETA" Foreground="#FFCF7A" FontSize="8" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                            </Button>

                            <Button x:Name="ControllerNavButton" Style="{StaticResource NavButtonStyle}" Tag="Controller" Click="NavigationButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconActivity}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" Width="18" Height="18" Stretch="Uniform" />
                                    <TextBlock Text="Controller" Margin="13,0,0,0" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="DiagnosticsNavButton" Style="{StaticResource NavButtonStyle}" Tag="Diagnostics" Click="NavigationButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconActivity}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" Width="18" Height="18" Stretch="Uniform" />
                                    <TextBlock Text="Diagnostics" Margin="13,0,0,0" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="SettingsNavButton" Style="{StaticResource NavButtonStyle}" Tag="Settings" Click="NavigationButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconSettings}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="18" Height="18" Stretch="Uniform" />
                                    <TextBlock Text="Advanced" Margin="13,0,0,0" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Border Grid.Row="2" Background="#1DFFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="34" Height="34" Background="#2AFFFFFF" CornerRadius="10">
                                        <Path Data="{StaticResource IconController}" Stroke="#98CBFF" StrokeThickness="1.6" Width="21" Height="21" Stretch="Uniform" />
                                    </Border>
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock Text="DualSense" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock x:Name="SidebarControllerState" Text="Waiting for test" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,12,0,0" Padding="10,8" Click="CheckControllerButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconCheck}" Stroke="#B7C1D2" StrokeThickness="2" Width="14" Height="14" Stretch="Uniform" />
                                        <TextBlock Text="Test connection" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Grid.Row="1" Margin="40,10,40,24">
                    <!-- OVERVIEW -->
                    <ScrollViewer x:Name="DashboardPage" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel>
                                    <TextBlock Text="Overview" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="Your DualSense on PC: games, headset audio, mic and lighting over Bluetooth." Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,5,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <Grid Margin="0,22,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.45*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource CardStyle}" Background="#1EFFFFFF" MinHeight="330">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#23FFFFFF" CornerRadius="10" Padding="10,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse x:Name="HeroStatusDot" Width="8" Height="8" Fill="#828894" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="HeroStatusText" Text="DISCONNECTED" Foreground="#B4BECC" FontSize="10" FontWeight="Bold" Margin="7,0,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock x:Name="HeroBatteryText" Text="BATTERY —" Foreground="#A7ADB9" FontSize="10" FontWeight="Bold" Margin="12,6,0,0" />
                                        </StackPanel>

                                        <!-- Live controller (buttons, sticks, triggers) instead of a static picture. -->
                                        <Viewbox Grid.Row="1" Stretch="Uniform" Margin="12,8">
                                            <ContentControl x:Name="HomeLiveView" Focusable="False" />
                                        </Viewbox>
                                        <Ellipse x:Name="DashboardGlow" Visibility="Collapsed" />

                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="DualSense Wireless Controller" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="16" />
                                                <TextBlock x:Name="HeroSubtitle" Text="Audio, mic and game mode start automatically" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <Button x:Name="SessionButton" Visibility="Collapsed" Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Click="SessionButton_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path x:Name="SessionButtonIcon" Data="{StaticResource IconPlay}" Fill="White" Width="14" Height="14" Stretch="Uniform" />
                                                    <TextBlock x:Name="SessionButtonText" Text="Start audio" Margin="9,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="2">
                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Quick setup" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="15" />
                                            <TextBlock Text="Captured output" Style="{StaticResource LabelStyle}" Margin="0,18,0,7" />
                                            <ComboBox x:Name="DashboardDeviceCombo" DisplayMemberPath="DisplayName" SelectionChanged="DashboardDeviceCombo_SelectionChanged" />

                                            <TextBlock Text="Controller output" Style="{StaticResource LabelStyle}" Margin="0,16,0,7" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <RadioButton x:Name="DashboardHeadsetRadio" Content="Headset jack" GroupName="DashboardTarget" Foreground="#D6DDE8" IsChecked="True" Checked="DashboardTarget_Checked" />
                                                <RadioButton x:Name="DashboardSpeakerRadio" Grid.Column="2" Content="Controller speaker" GroupName="DashboardTarget" Foreground="#D6DDE8" Checked="DashboardTarget_Checked" />
                                            </Grid>
                                            <CheckBox x:Name="GameControllerCheckBox" Margin="0,12,0,0" Foreground="#D6DDE8" IsChecked="True"
                                                      Checked="GameControllerCheckBox_Changed" Unchecked="GameControllerCheckBox_Changed"
                                                      Content="Game controller (touchpad = mouse)"
                                                      ToolTip="Uses ViGEmBus. Works without starting audio. Game rumble goes to the DualSense." />
                                            <Grid Margin="26,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="44" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Touchpad speed" Foreground="#A7ADB9" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                <Slider x:Name="TouchpadSpeedSlider" Grid.Column="1" Minimum="0.3" Maximum="3" Value="1" ValueChanged="TouchpadSpeedSlider_ValueChanged" />
                                                <TextBlock x:Name="TouchpadSpeedText" Grid.Column="2" Text="1.0×" Foreground="#D6DDE8" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="26,8,0,0">
                                                <TextBlock Text="Games see:" Foreground="#A7ADB9" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                <RadioButton x:Name="EmulateXboxRadio" GroupName="Emulation" Content="Xbox" Foreground="#D6DDE8" IsChecked="True" Checked="EmulationMode_Checked" Margin="0,0,16,0" />
                                                <RadioButton x:Name="EmulatePlayStationRadio" GroupName="Emulation" Content="PlayStation" Foreground="#D6DDE8" Checked="EmulationMode_Checked"
                                                             ToolTip="Emulates a DualShock 4 (ViGEm has no PS5 target) so games show PlayStation button prompts." />
                                            </StackPanel>
                                            <CheckBox x:Name="MicEnabledCheckBox" Margin="0,12,0,0" Foreground="#D6DDE8" IsChecked="True"
                                                      Checked="MicEnabledCheckBox_Changed" Unchecked="MicEnabledCheckBox_Changed"
                                                      Content="Microphone"
                                                      ToolTip="Shows in Windows as &quot;DualSense Wireless Controller&quot; (Headset Microphone)." />
                                            <StackPanel Orientation="Horizontal" Margin="26,8,0,0">
                                                <CheckBox x:Name="NoiseRemovalCheckBox" Content="Noise removal" IsChecked="True" Margin="0,0,18,0"
                                                          Checked="MicOption_Changed" Unchecked="MicOption_Changed" ToolTip="Filters fan/keyboard hum and silences the mic when you're not talking." />
                                                <CheckBox x:Name="SidetoneCheckBox" Visibility="Collapsed" Content="Hear myself" IsChecked="False"
                                                          Checked="MicOption_Changed" Unchecked="MicOption_Changed" ToolTip="Sidetone: plays your own voice quietly in the headphones, like a PS5 headset." />
                                            </StackPanel>
                                            <CheckBox x:Name="HapticsCheckBox" Margin="0,12,0,0" IsChecked="False" Content="Haptics from game sound (beta)"
                                                      Checked="MicOption_Changed" Unchecked="MicOption_Changed" ToolTip="Feel game audio (bass, explosions) in the DualSense haptic motors." />
                                            <CheckBox x:Name="LowLatencyCheckBox" Margin="0,12,0,0" IsChecked="False" Content="Low latency mode"
                                                      Checked="MicOption_Changed" Unchecked="MicOption_Changed"
                                                      ToolTip="Smaller audio buffers (about half the headphone and mic delay) and top-priority controller input. Turn off if audio crackles." />
                                            <CheckBox x:Name="BatteryLightCheckBox" Margin="0,12,0,0" IsChecked="False" Content="Battery-colored light bar"
                                                      ToolTip="Green when charged, yellow when half, red when low. Alerts at 20% and 10%." />
                                            <CheckBox x:Name="StartupCheckBox" Margin="0,12,0,0" IsChecked="False" Content="Start with Windows (in tray)"
                                                      Checked="StartupCheckBox_Changed" Unchecked="StartupCheckBox_Changed" />

                                            <Grid Margin="0,18,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Volume" Style="{StaticResource LabelStyle}" />
                                                <TextBlock x:Name="DashboardVolumeText" Grid.Column="1" Text="100 / 127" Foreground="#C9CFDB" FontSize="12" />
                                            </Grid>
                                            <Slider x:Name="DashboardVolumeSlider" Minimum="0" Maximum="127" Value="100" TickFrequency="1" ValueChanged="DashboardVolumeSlider_ValueChanged" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="18">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Lightbar" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock x:Name="DashboardHexText" Text="#61B0FF" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <Border x:Name="DashboardColorSwatch" Grid.Column="1" Width="38" Height="38" Background="#61B0FF" CornerRadius="12" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource CardStyle}" Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="CONTROLLER" Foreground="#A7ADB9" FontSize="10" FontWeight="Bold" />
                                        <TextBlock x:Name="TileControllerText" Text="Searching…" Foreground="{StaticResource TextBrush}" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,0" />
                                        <TextBlock x:Name="TileControllerSub" Text="Bluetooth" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
                                        <!-- Kept for engine status updates; not shown. -->
                                        <TextBlock x:Name="DashboardConnectionText" Visibility="Collapsed" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="GAMES" Foreground="#A7ADB9" FontSize="10" FontWeight="Bold" />
                                        <TextBlock x:Name="TileGameText" Text="Off" Foreground="{StaticResource TextBrush}" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,0" />
                                        <TextBlock Text="Controller emulation" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
                                        <TextBlock x:Name="ReportsText" Visibility="Collapsed" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="HEADSET AUDIO" Foreground="#A7ADB9" FontSize="10" FontWeight="Bold" />
                                        <TextBlock x:Name="TileAudioText" Text="Off" Foreground="{StaticResource TextBrush}" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,0" />
                                        <TextBlock x:Name="BufferText" Text="Press Start audio" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
                                        <TextBlock x:Name="QueueText" Visibility="Collapsed" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="6" Style="{StaticResource CardStyle}" Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="MICROPHONE" Foreground="#A7ADB9" FontSize="10" FontWeight="Bold" />
                                        <TextBlock x:Name="TileMicText" Text="Off" Foreground="{StaticResource TextBrush}" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,0" />
                                        <TextBlock Text="Hi-Fi Cable Output" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- AUDIO -->
                    <ScrollViewer x:Name="AudioPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Audio" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Choose the Windows audio output to encode and send to the DualSense." Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,5,0,0" />

                            <Grid Margin="0,22,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.15*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Routing" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Text="WASAPI loopback to the Bluetooth protocol" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Padding="12,8" Click="RefreshDevicesButton_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconRefresh}" Fill="#BFC8D7" Width="14" Height="14" Stretch="Uniform" />
                                                    <TextBlock Text="Refresh" Margin="7,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <TextBlock Text="Windows output" Style="{StaticResource LabelStyle}" Margin="0,22,0,8" />
                                        <ComboBox x:Name="AudioDeviceCombo" DisplayMemberPath="DisplayName" SelectionChanged="AudioDeviceCombo_SelectionChanged" />

                                        <TextBlock Text="Destination" Style="{StaticResource LabelStyle}" Margin="0,20,0,10" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <RadioButton x:Name="HeadsetRadio" GroupName="AudioTarget" IsChecked="True" Checked="AudioTarget_Checked">
                                                <Border Background="#24FFFFFF" BorderBrush="#2A3650" BorderThickness="1" CornerRadius="12" Padding="15">
                                                    <StackPanel>
                                                        <Path Data="{StaticResource IconHeadset}" Stroke="#91C7FE" StrokeThickness="1.7" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Left" />
                                                        <TextBlock Text="Headset jack" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,9,0,0" />
                                                        <TextBlock Text="Connected to the controller" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </RadioButton>
                                            <RadioButton x:Name="SpeakerRadio" Grid.Column="2" GroupName="AudioTarget" Checked="AudioTarget_Checked">
                                                <Border Background="#24FFFFFF" BorderBrush="#2A3650" BorderThickness="1" CornerRadius="12" Padding="15">
                                                    <StackPanel>
                                                        <Path Data="{StaticResource IconSpeaker}" Stroke="#91C7FE" StrokeThickness="1.7" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Left" />
                                                        <TextBlock Text="Controller speaker" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,9,0,0" />
                                                        <TextBlock Text="Built-in DualSense output" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </RadioButton>
                                        </Grid>

                                        <Grid Margin="0,22,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Controller volume" Style="{StaticResource LabelStyle}" />
                                            <TextBlock x:Name="VolumeValueText" Grid.Column="1" Text="100 / 127" Foreground="#C5CEDB" FontSize="12" />
                                        </Grid>
                                        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="127" Value="100" TickFrequency="1" ValueChanged="VolumeSlider_ValueChanged" Margin="0,9,0,0" />

                                        <Grid Margin="0,22,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="StartAudioButton" Visibility="Collapsed" Style="{StaticResource PrimaryButtonStyle}" Click="StartAudioButton_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconPlay}" Fill="White" Width="13" Height="13" Stretch="Uniform" />
                                                    <TextBlock Text="Start session" Margin="8,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="StopAudioButton" Visibility="Collapsed" Grid.Column="2" Style="{StaticResource DangerButtonStyle}" Click="StopAudioButton_Click" IsEnabled="False">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconStop}" Fill="#FF9AA5" Width="13" Height="13" Stretch="Uniform" />
                                                    <TextBlock Text="Stop" Margin="8,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Column="2">
                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Test tone" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="Verify the audio path before starting loopback." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />

                                            <TextBlock Text="Frequency" Style="{StaticResource LabelStyle}" Margin="0,20,0,7" />
                                            <TextBox x:Name="ToneFrequencyTextBox" Text="440" />
                                            <TextBlock Text="Duration in seconds" Style="{StaticResource LabelStyle}" Margin="0,16,0,7" />
                                            <TextBox x:Name="ToneSecondsTextBox" Text="5" />
                                            <TextBlock Text="Safe amplitude" Style="{StaticResource LabelStyle}" Margin="0,16,0,7" />
                                            <TextBox x:Name="ToneAmplitudeTextBox" Text="0.08" />

                                            <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,20,0,0" Click="ToneButton_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconPlay}" Fill="#C7D0DE" Width="13" Height="13" Stretch="Uniform" />
                                                    <TextBlock Text="Run test" Margin="8,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0" Background="#1CFFFFFF" BorderBrush="#29FFFFFF">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="34" Height="34" Background="#23FFFFFF" CornerRadius="10">
                                                <Path Data="{StaticResource IconCheck}" Stroke="{StaticResource SuccessBrush}" StrokeThickness="2.2" Width="16" Height="16" Stretch="Uniform" />
                                            </Border>
                                            <StackPanel Margin="12,0,0,0">
                                                <TextBlock Text="v5.5 engine preserved" Foreground="#DDF7ED" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Text="ClockFix, SendQueue, and Opus remain in the original core." Foreground="#A3A9B5" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- LIGHTING -->
                    <ScrollViewer x:Name="LightingPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Lighting" Style="{StaticResource SectionTitleStyle}" />
                                <Border Background="#27FFFFFF" BorderBrush="#6A5126" BorderThickness="1" CornerRadius="7" Padding="8,3" Margin="10,2,0,0" VerticalAlignment="Top">
                                    <TextBlock Text="BETA" Foreground="#FFCF7A" FontSize="9" FontWeight="Bold" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Experimental controls for the lightbar and player indicators." Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,5,0,0" />

                            <Border Background="#1DFFFFFF" BorderBrush="#5A4327" BorderThickness="1" CornerRadius="12" Padding="15,12" Margin="0,14,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" Background="#26FFFFFF" CornerRadius="10">
                                        <Path Data="{StaticResource IconActivity}" Stroke="#FFBF5F" StrokeThickness="2" Width="18" Height="18" Stretch="Uniform" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="Before you test" Foreground="#FFE0A8" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Close DSX completely before applying a color. While DSX is running, it will keep control of the lightbar and changes from this app will not work."
                                                   Foreground="#CDB891"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   LineHeight="17"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border x:Name="LightingOwnershipCard" Background="#1FFFFFFF" BorderBrush="#27414B" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,14,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Experimental lighting control" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock x:Name="LightingOwnershipStateText"
                                                   Text="Disabled. DSX will continue controlling the lighting."
                                                   Foreground="#AEB4C0"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,18,0" />
                                    </StackPanel>
                                    <CheckBox x:Name="AppLightingControlCheckBox"
                                              Grid.Column="1"
                                              Content="Control lighting with this app"
                                              Foreground="#DDF7ED"
                                              FontWeight="SemiBold"
                                              IsChecked="False"
                                              VerticalAlignment="Center"
                                              Checked="AppLightingControlCheckBox_Changed"
                                              Unchecked="AppLightingControlCheckBox_Changed" />
                                </Grid>
                            </Border>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.12*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource CardStyle}" Background="#1DFFFFFF" MinHeight="490">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Preview" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Text="Adjust the preview, then apply when ready." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <CheckBox x:Name="LedEnabledCheckBox" Grid.Column="1" Content="Lightbar enabled" Foreground="#D7DFEA" IsChecked="True" Checked="LedEnabledCheckBox_Changed" Unchecked="LedEnabledCheckBox_Changed" />
                                        </Grid>

                                        <Viewbox Grid.Row="1" Stretch="Uniform" Margin="6,2">
                                            <Canvas Width="620" Height="350">
                                                <Ellipse x:Name="LightingGlow" Width="470" Height="125" Canvas.Left="75" Canvas.Top="212" Fill="#0059B2" Opacity="0.68">
                                                    <Ellipse.Effect>
                                                        <BlurEffect Radius="48" />
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                                <Image Source="Assets/DualSense.png"
                                                       Width="740"
                                                       Height="389"
                                                       Canvas.Left="-60"
                                                       Canvas.Top="-12"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                <StackPanel x:Name="PlayerLedPreview" Visibility="Collapsed" Orientation="Horizontal">
                                                    <Ellipse Width="6" Height="6" Fill="#8AC4FF" Margin="2" />
                                                    <Ellipse Width="6" Height="6" Fill="#2BFFFFFF" Margin="2" />
                                                    <Ellipse Width="6" Height="6" Fill="#2BFFFFFF" Margin="2" />
                                                    <Ellipse Width="6" Height="6" Fill="#2BFFFFFF" Margin="2" />
                                                    <Ellipse Width="6" Height="6" Fill="#2BFFFFFF" Margin="2" />
                                                </StackPanel>
                                            </Canvas>
                                        </Viewbox>

                                        <Border Grid.Row="2" Background="#20FFFFFF" CornerRadius="12" Padding="14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="LightingColorSwatch" Width="42" Height="42" CornerRadius="12" Background="#61B0FF" />
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock Text="Current color" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                                    <TextBlock x:Name="LightingHexLabel" Text="#61B0FF" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="RGB" Foreground="#848A96" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>

                                <StackPanel x:Name="LightingEditorPanel" Grid.Column="2">
                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Custom color" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold" />

                                            <Grid Margin="0,20,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="Red" Style="{StaticResource LabelStyle}" />
                                                <TextBlock x:Name="RedValueText" Grid.Column="1" Text="98" Foreground="#FF8B98" FontSize="12" />
                                            </Grid>
                                            <Slider x:Name="RedSlider" Minimum="0" Maximum="255" Value="98" ValueChanged="ColorSlider_ValueChanged" Margin="0,7,0,0" />

                                            <Grid Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="Green" Style="{StaticResource LabelStyle}" />
                                                <TextBlock x:Name="GreenValueText" Grid.Column="1" Text="124" Foreground="#72E4B6" FontSize="12" />
                                            </Grid>
                                            <Slider x:Name="GreenSlider" Minimum="0" Maximum="255" Value="124" ValueChanged="ColorSlider_ValueChanged" Margin="0,7,0,0" />

                                            <Grid Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="Blue" Style="{StaticResource LabelStyle}" />
                                                <TextBlock x:Name="BlueValueText" Grid.Column="1" Text="255" Foreground="#8FC6FE" FontSize="12" />
                                            </Grid>
                                            <Slider x:Name="BlueSlider" Minimum="0" Maximum="255" Value="255" ValueChanged="ColorSlider_ValueChanged" Margin="0,7,0,0" />

                                            <TextBlock Text="HEX" Style="{StaticResource LabelStyle}" Margin="0,17,0,7" />
                                            <TextBox x:Name="HexTextBox" Text="#61B0FF" LostFocus="HexTextBox_LostFocus" KeyDown="HexTextBox_KeyDown" />

                                            <Grid Margin="0,18,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Brightness" Style="{StaticResource LabelStyle}" Margin="0,0,0,7" />
                                                    <ComboBox x:Name="BrightnessCombo" SelectionChanged="LightingOption_SelectionChanged">
                                                        <ComboBoxItem Content="Bright" Tag="0" IsSelected="True" />
                                                        <ComboBoxItem Content="Medium" Tag="1" />
                                                        <ComboBoxItem Content="Dim" Tag="2" />
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Player LEDs" Style="{StaticResource LabelStyle}" Margin="0,0,0,7" />
                                                    <ComboBox x:Name="PlayerLedsCombo" SelectionChanged="LightingOption_SelectionChanged">
                                                        <ComboBoxItem Content="Off" Tag="0" />
                                                        <ComboBoxItem Content="Player 1" Tag="4" IsSelected="True" />
                                                        <ComboBoxItem Content="Player 2" Tag="10" />
                                                        <ComboBoxItem Content="Player 3" Tag="21" />
                                                        <ComboBoxItem Content="All" Tag="31" />
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>

                                            <Button x:Name="ApplyLightingButton"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Margin="0,20,0,0"
                                                    Click="ApplyLightingButton_Click"
                                                    IsEnabled="False">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconCheck}" Stroke="White" StrokeThickness="2" Width="14" Height="14" Stretch="Uniform" />
                                                    <TextBlock x:Name="ApplyLightingButtonText" Text="Lighting applied" Margin="8,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <TextBlock x:Name="LightingApplyHint"
                                                       Text="Change a color to enable the button."
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="10"
                                                       TextAlignment="Center"
                                                       Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="18">
                                        <StackPanel>
                                            <TextBlock Text="Quick colors" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="13" />
                                            <WrapPanel Margin="0,13,0,0">
                                                <Button Tag="627CFF" Click="ColorPresetButton_Click" Style="{StaticResource SwatchStyle}" Background="#627CFF" ToolTip="Blue" />
                                                <Button Tag="4DDEB5" Click="ColorPresetButton_Click" Style="{StaticResource SwatchStyle}" Background="#4DDEB5" ToolTip="Green" />
                                                <Button Tag="FF5F77" Click="ColorPresetButton_Click" Style="{StaticResource SwatchStyle}" Background="#FF5F77" ToolTip="Red" />
                                                <Button Tag="B56CFF" Click="ColorPresetButton_Click" Style="{StaticResource SwatchStyle}" Background="#B56CFF" ToolTip="Purple" />
                                                <Button Tag="FFB24D" Click="ColorPresetButton_Click" Style="{StaticResource SwatchStyle}" Background="#FFB24D" ToolTip="Amber" />
                                                <Button Tag="FFFFFF" Click="ColorPresetButton_Click" Style="{StaticResource SwatchStyle}" Background="#FFFFFF" ToolTip="White" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- CONTROLLER LIVE VIEW (content set in code) -->
                    <ContentControl x:Name="ControllerPage" Visibility="Collapsed" />

                    <!-- DIAGNOSTICS -->
                    <Grid x:Name="DiagnosticsPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Diagnostics" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Real-time logs from the engine, WASAPI, Opus, and the HID queue." Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,5,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource SecondaryButtonStyle}" Padding="13,9" Margin="0,0,8,0" Click="MicProbeButton_Click" ToolTip="Experimental: enable the controller mic and record what it sends over Bluetooth">
                                    <TextBlock Text="Mic probe (beta)" />
                                </Button>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Padding="13,9" Click="ClearLogButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconTrash}" Stroke="#BFC8D7" StrokeThickness="1.7" Width="14" Height="14" Stretch="Uniform" />
                                        <TextBlock Text="Clear" Margin="7,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Padding="13,9" Margin="8,0,0,0" Click="OpenLogsButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconFolder}" Stroke="#BFC8D7" StrokeThickness="1.7" Width="14" Height="14" Stretch="Uniform" />
                                        <TextBlock Text="Open logs" Margin="7,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" Background="#15FFFFFF">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="44" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Background="#1BFFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="18,18,0,0">
                                    <Grid Margin="16,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="#FF6B7A" Margin="0,0,7,0" />
                                            <Ellipse Width="8" Height="8" Fill="#FFB24D" Margin="0,0,7,0" />
                                            <Ellipse Width="8" Height="8" Fill="#54D6A4" Margin="0,0,13,0" />
                                            <TextBlock Text="DualSenseBtAudio · session" Foreground="#9DA3AF" FontFamily="Consolas" FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBox x:Name="DiagnosticsLog" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Background="#15FFFFFF" BorderThickness="0" Foreground="#B7C3D3" Padding="18" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ADVANCED -->
                    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Advanced" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Bluetooth transport settings. The v5.5 defaults are recommended." Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,5,0,0" />

                            <Grid Margin="0,22,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Protocol" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="Report mode" Style="{StaticResource LabelStyle}" Margin="0,20,0,8" />
                                        <ComboBox x:Name="ProtocolCombo" SelectionChanged="AdvancedOption_Changed">
                                            <ComboBoxItem Content="Full39 · recommended" Tag="Full39" IsSelected="True" />
                                            <ComboBoxItem Content="Legacy35 · comparison" Tag="Legacy35" />
                                        </ComboBox>

                                        <Grid Margin="0,22,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Report buffer" Style="{StaticResource LabelStyle}" />
                                            <TextBlock x:Name="BufferLengthValueText" Grid.Column="1" Text="64" Foreground="#C5CEDB" />
                                        </Grid>
                                        <Slider x:Name="BufferLengthSlider" Minimum="1" Maximum="127" Value="64" TickFrequency="1" ValueChanged="BufferLengthSlider_ValueChanged" Margin="0,9,0,0" />

                                        <TextBlock Text="Send period (ms)" Style="{StaticResource LabelStyle}" Margin="0,20,0,8" />
                                        <TextBox x:Name="PeriodTextBox" Text="21.333333" LostFocus="AdvancedTextBox_LostFocus" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Background="#1CFFFFFF" BorderBrush="#2BFFFFFF">
                                    <StackPanel>
                                        <TextBlock Text="Important note" Foreground="#FFD4A0" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="Changing the buffer or period can cause crackling, underflows, or interrupted HID writes. If performance gets worse, restore the defaults: Full39, buffer 64, and 21.333333 ms." Foreground="#B4BAC6" FontSize="12" TextWrapping="Wrap" LineHeight="20" Margin="0,13,0,0" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,22,0,0" HorizontalAlignment="Left" Click="RestoreDefaultsButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconRefresh}" Fill="#C7D0DE" Width="14" Height="14" Stretch="Uniform" />
                                                <TextBlock Text="Restore defaults" Margin="8,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Protected architecture" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="The interface and engine run separately. Audio continues to use SendQueue, ClockFix, and high priority." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#23FFFFFF" CornerRadius="12" Padding="13,7">
                                        <TextBlock Text="v0.0.1 UI · CORE v5.5" Foreground="{StaticResource SuccessBrush}" FontSize="10" FontWeight="Bold" />
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- PS5-style focus ring for controller navigation; follows the focused control. -->
            <Canvas x:Name="FocusOverlay" Grid.RowSpan="2" IsHitTestVisible="False">
                <Border x:Name="FocusRing" BorderBrush="White" BorderThickness="3" CornerRadius="12" Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#7FB8FF" Opacity="0.9" />
                    </Border.Effect>
                </Border>
            </Canvas>
        </Grid>
    </Border>
</Window>
